{
  "expo": {
    "name": "Scorely",
    "slug": "scorely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/scorely-icon.png",
    "scheme": "scorely",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/scorely-icon.png",
      "bundleIdentifier": "com.lucianbutuc.scorely"
    },
    "android": {
      "package": "com.lucianbutuc.scorely",
      "adaptiveIcon": {
        "backgroundColor": "#22C55E",
        "foregroundImage": "./assets/images/scorely-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/scorely-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#22C55E",
          "image": "./assets/images/scorely-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c173551-6850-49da-988d-43441c6e1ebb"
      }
    }
  }
}
